@page "/"
@rendermode InteractiveServer

<div class="app-shell">

    <!-- ══════════════════════════════════════════════════════
         SIDEBAR
    ══════════════════════════════════════════════════════ -->
    <aside class="sidebar">

        <div class="sidebar-game-header">
            <div class="sidebar-game-icon">🎮</div>
            <div class="sidebar-game-name">Elastic Slap</div>
            <div class="sidebar-game-sub">Ketchapp — Internal</div>
            <a class="sidebar-link" href="#" @onclick:preventDefault>⊞ App Store Connect</a>
            <div class="sidebar-badges">
                <span class="sidebar-badge-version">1.3.1 ✏</span>
                <span style="background:rgba(255,255,255,.12);color:#fff;border-radius:4px;font-size:.72rem;font-weight:600;padding:2px 7px">🔍</span>
                <span class="sidebar-badge-low">Low</span>
            </div>
        </div>

        <div class="sidebar-people">
            <div class="sidebar-people-grid">
                <div>
                    <div class="sidebar-person-label">Author</div>
                    <div class="sidebar-avatar" style="background:#5b6abf">🤖</div>
                    <div class="sidebar-person-name">Portal Bot</div>
                </div>
                <div>
                    <div class="sidebar-person-label">Owner</div>
                    <div class="sidebar-avatar" style="background:#2980b9">CD</div>
                    <div class="sidebar-person-name">Corentin<br />Durrieu</div>
                </div>
                <div>
                    <div class="sidebar-person-label">Reviewer</div>
                    <div class="sidebar-avatar" style="background:#e67e22">EB</div>
                    <div class="sidebar-person-name">Etienne<br />Bottichio</div>
                </div>
            </div>
        </div>

        <div class="sidebar-nav">
            <div class="sidebar-nav-label">QR Code</div>
            <span class="sidebar-nav-link active">Debugger</span>
            <span class="sidebar-nav-link">Mediation debugger</span>
            <span class="sidebar-nav-link">Custom GA id</span>
        </div>

        <div style="padding:0 1.25rem">
            <div class="sidebar-qr">
                <div style="font-size:2.2rem">▦</div>
            </div>
            <div class="sidebar-qr-label">Scan to open app with</div>
        </div>

    </aside>

    <!-- ══════════════════════════════════════════════════════
         MAIN CONTENT
    ══════════════════════════════════════════════════════ -->
    <div class="main-content">

        <!-- Revision header -->
        <div class="revision-header">
            <div style="display:flex;justify-content:space-between;align-items:flex-start">
                <div style="flex:1">
                    <div class="revision-header-title">Revision #1 selected</div>
                    <div class="rev-row">
                        <div class="rev-field">
                            <label>Revision</label>
                            <select class="rev-select">
                                <option># 1 — Apr 15, 2026 10:15 AM</option>
                            </select>
                        </div>
                        <div class="rev-field">
                            <label>Revision status</label>
                            <div class="rev-status-wrapper">
                                <select class="rev-select" style="min-width:200px">
                                    <option>✅ Live on the store</option>
                                </select>
                                <div class="rev-toggle"></div>
                            </div>
                        </div>
                        <div class="rev-field">
                            <label>Live on store date</label>
                            <input type="text" value="04/23/2026" style="border:1px solid #d0d5e8;border-radius:6px;padding:.35rem .6rem;font-size:.85rem" />
                        </div>
                    </div>
                    <div class="rev-note">Rollout is only available for Android</div>
                </div>
                <div style="text-align:right;padding-left:1.5rem;flex-shrink:0">
                    <div style="width:90px;height:90px;background:#f0f0f0;border:1px solid #ddd;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:2.5rem;margin-left:auto;margin-bottom:.5rem">▦</div>
                    <a href="#" @onclick:preventDefault style="display:block;font-size:.78rem;color:#1d2480">Download ZIP</a>
                    <a href="#" @onclick:preventDefault style="display:block;font-size:.78rem;color:#1d2480">Download IPA</a>
                    <span style="font-size:.78rem;color:#666">Ipa file: </span>
                    <a href="#" @onclick:preventDefault style="font-size:.78rem;color:#1d2480">Download build.ipa</a>
                </div>
            </div>

            <!-- Tab bar -->
            <div class="tab-bar">
                <button class="tab-btn @(_activeTab == "details"     ? "active"    : "")" @onclick='() => _activeTab = "details"'>Details</button>
                <button class="tab-btn @(_activeTab == "sdk"         ? "active"    : "")" @onclick='() => _activeTab = "sdk"'>SDK List</button>
                <button class="tab-btn @(_activeTab == "integration" ? "active"    : "")" @onclick='() => _activeTab = "integration"'>Integration Manager</button>
                <button class="tab-btn @(_activeTab == "bugs"        ? "active-v2" : "")" @onclick='() => _activeTab = "bugs"'>Bug Reports</button>
            </div>
        </div>

        <!-- ── Details tab (cosmetic) ─────────────────────── -->
        @if (_activeTab == "details")
        {
            <div class="tab-pane">
                <div style="max-width:900px">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Comments:</h5>
                        <button class="btn btn-sm text-white" style="background:#1d2480">Add Comment</button>
                    </div>
                    <div class="bg-light rounded p-3 text-muted mb-4">No comment for the moment</div>
                    <div class="d-flex gap-4">
                        <div style="flex:1">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="fw-bold mb-0">Changelog:</h5>
                                <button class="btn btn-sm btn-outline-primary">✏ Edit</button>
                            </div>
                            <div class="bg-light rounded p-3">
                                <div class="small text-muted">Build 2 — Type: Release (Profilable: )</div>
                                <div class="small text-muted">Branch: origin/UpdateMayo — Commit: 7cb5981</div>
                            </div>
                        </div>
                        <div style="flex:1">
                            <h5 class="fw-bold mb-3">History of revision #1:</h5>
                            <div class="d-flex gap-2 align-items-start">
                                <div style="width:10px;height:10px;background:#1d2480;border-radius:50%;margin-top:4px;flex-shrink:0"></div>
                                <div>
                                    <div class="fw-bold small" style="color:#1d2480">Thursday, April 23, 2026</div>
                                    <div class="small text-muted">8:56 AM</div>
                                    <div class="small">Changed state to Live on store</div>
                                    <div class="small text-muted">Etienne Bottichio (Ketchapp)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ── SDK List tab (cosmetic) ───────────────────── -->
        @if (_activeTab == "sdk")
        {
            <div class="tab-pane">
                <div class="placeholder-section">SDK List — not available in this revision</div>
            </div>
        }

        <!-- ── Integration Manager tab (cosmetic) ────────── -->
        @if (_activeTab == "integration")
        {
            <div class="tab-pane">
                <div class="placeholder-section">Integration Manager — not available in this revision</div>
            </div>
        }

        <!-- ── Bug Reports tab — fully functional ─────────── -->
        @if (_activeTab == "bugs")
        {
            <div class="tab-pane" style="padding:1.5rem 2rem">
                <BugReports.BugReportsTab />
            </div>
        }

    </div>
</div>

@code {
    private string _activeTab = "details";
}
